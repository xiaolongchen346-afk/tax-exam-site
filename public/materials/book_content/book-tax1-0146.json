{"id": "book-tax1-0146", "title": "2025年《税法（一）》高频考点第9章 烟叶税", "subjectId": "tax1", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "sections": [{"title": "第九章 烟叶税", "level": 1, "content": "历年考情概况\n考试分值 2 分左右\n考查形式 单项选择题、多项选项题\n高频考点 烟叶税\n【考点一】烟叶税（★）", "id": "ea9328c1ecef", "format": "note"}, {"title": "（一）纳税人和征税对象", "level": 2, "content": "", "id": "04fc8d16c776"}, {"title": "1.纳税人：在我国境内收购烟叶的单位。", "level": 1, "content": "", "id": "b7190814a2dd"}, {"title": "2.征税对象：晾晒烟叶、烤烟叶。", "level": 1, "content": "", "id": "d41cadfe1f69"}, {"title": "（二）应纳税额计算", "level": 2, "content": "", "id": "3d99c0f491b6"}, {"title": "1.收购烟叶应缴纳的烟叶税：", "level": 1, "content": "应纳烟叶税税额＝烟叶实际支付的价款总额×20％烟叶实际支付的价款总额＝收购价款×（1＋10％），10％为价外补贴", "id": "0b332430631f", "format": "formula"}, {"title": "2.收购烟叶可抵扣的增值税：", "level": 1, "content": "", "id": "2087d5f2991d"}, {"title": "（1）价外补贴按 10%计算的：", "level": 2, "content": "烟叶进项税额＝收购价款×（1＋10％）×（1＋20％）×9％（10％）", "id": "9ad192ff20c9", "format": "formula"}, {"title": "（2）实际支付价外补贴：", "level": 2, "content": "烟叶进项税额＝（收购价款＋实际支付的价外补贴＋烟叶税）×9％（10％）\n＝[收购价款＋实际支付的价外补贴＋收购价款×（1＋10％）×20%]×9％（10％）", "id": "29f01bdc517c", "format": "formula"}, {"title": "（三）征收管理", "level": 2, "content": "", "id": "0c1845239bc2"}, {"title": "1.纳税义务发生时间：纳税人收购烟叶的当天。", "level": 1, "content": "", "id": "b9fdcdbc65c3"}, {"title": "2.纳税地点：收购地的主管税务机关。", "level": 1, "content": "", "id": "d076ff870e6b"}, {"title": "3.纳税期限：纳税义务发生月终了之日起 15 日内。", "level": 1, "content": "", "id": "10489e0d9ffa"}], "formulas": [{"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "（二）应纳税额计算"}, {"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "应纳烟叶税税额＝烟叶实际支付的价款总额×20％"}, {"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "烟叶实际支付的价款总额＝收购价款×（1＋10％），10％为价外补贴"}, {"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "烟叶进项税额＝收购价款×（1＋10％）×（1＋20％）×9％（10％）"}, {"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "烟叶进项税额＝（收购价款＋实际支付的价外补贴＋烟叶税）×9％（10％）"}, {"bookId": "book-tax1-0146", "subjectName": "税法（一）", "materialName": "高频考点与重难点", "text": "＝[收购价款＋实际支付的价外补贴＋收购价款×（1＋10％）×20%]×9％（10％）"}]}